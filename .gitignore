# ===================== Python =====================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===================== 构建缓存（可再生） =====================
# 模板背景解包缓存、配图去底/裁边缓存 —— 由 build.py 自动重建
.cache/

# =====================================================================
# 只在本机保留：具体墙报任务与赛事材料
# ---------------------------------------------------------------------
# 本仓库发布的是**通用排版引擎**；随附的具体任务（作品文案、素材图、官方模板、
# 参考样张、成品 pptx）属赛事与作品材料，仅在本机保留，不入库、不推送。
# 仓库里只留不含内容的示例任务 tasks/demo 与任务骨架 tasks/_template.md。
#
# 注意：这里的路径一律**根锚定**（前导 /）。写成不带 / 的 `assets/` 会匹配任意层级，
# 把 tasks/demo/assets/ 也一并忽略掉。
# =====================================================================

# 具体任务目录（只放行示例任务、骨架与说明）
/tasks/*
!/tasks/README.md
!/tasks/_template.md
!/tasks/demo/
!/tasks/demo/**

# 跨任务共享素材：官方模板 / 参考样张 / 素材文档逐页渲染
/assets/

# 历史脚本、文案草稿与旧交付物（已归档，勿运行）
/legacy/

# 交付物（成品 pptx 含作品内容）与合规报告；预览图每次构建都会重画
/dist/

# 内部工作记录（含作品相关讨论与基线哈希）
/.workbuddy/

# ===================== 探针 / 复核的中间产物 =====================
# 渲染器探针（tools/probe_metrics.py）与 PowerPoint 真值复核落下的临时 pptx / png
tools/_probe/

# ===================== 临时比对文件 =====================
_*.pptx
_*.png

# ===================== 系统 / 编辑器 =====================
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.bak
~$*
